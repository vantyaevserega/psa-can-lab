<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="lab_background">#161616</color>
    <color name="lab_panel">#222222</color>
    <color name="lab_orange">#FF8C00</color>
    <color name="lab_text">#E0E0E0</color>
    <color name="lab_dim">#8A8A8A</color>

    <style name="AppTheme" parent="@android:style/Theme.Material">
        <item name="android:colorAccent">@color/lab_orange</item>
        <item name="android:windowBackground">@color/lab_background</item>
        <item name="android:colorPrimary">@color/lab_panel</item>
        <item name="android:colorPrimaryDark">@color/lab_background</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/lab_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FrameTable">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/lab_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:typeface">monospace</item>
    </style>
</resources>
