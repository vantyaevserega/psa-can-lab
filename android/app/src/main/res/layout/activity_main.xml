<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/link_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/lab_orange"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mode_idle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_idle" />

        <Button
            android:id="@+id/mode_sniff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_sniff" />

        <Button
            android:id="@+id/mode_bench"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_bench" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- Ничего не выбрано -->
        <TextView
            android:id="@+id/idle_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/idle_hint"
            android:textColor="@color/lab_text"
            android:textSize="16sp" />

        <!-- Прослушивание шины -->
        <LinearLayout
            android:id="@+id/sniff_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/filter_hint"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:singleLine="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pause" />

                <Button
                    android:id="@+id/clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear" />

                <CheckBox
                    android:id="@+id/record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/record"
                    android:textColor="@color/lab_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/lost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_orange"
                android:textSize="13sp"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/sniff_table"
                        style="@style/FrameTable" />
                </HorizontalScrollView>
            </ScrollView>
        </LinearLayout>

        <!-- Стенд дисплея: элементы управления добавляются из кода -->
        <ScrollView
            android:id="@+id/bench_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/bench_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </FrameLayout>

    <TextView
        style="@style/SectionTitle"
        android:text="@string/title_log" />

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:gravity="bottom"
        android:textColor="@color/lab_dim"
        android:textSize="12sp"
        android:typeface="monospace" />
</LinearLayout>
